# Заголовки для Cloudflare Pages.
#
# Это те две вещи, которые Privy требует подтвердить при переводе в прод, и
# требует по делу: мы подписываем платежи, а не показываем блог.
#
# Правила кэша здесь тоже - Pages склеивает все подходящие блоки, а не выбирает
# один, поэтому общего правила на / нет намеренно: рядом с частным значением
# появлялось бы ещё и общее, и браузер читал бы первое.

/*
  # Кто может исполняться и куда можно ходить. Всё, чего нет в списке, браузер
  # заблокирует - в том числе чужой скрипт, заехавший через зависимость.
  #
  # 'unsafe-inline' в script-src: Next при статическом экспорте кладёт на
  # страницу встроенные скрипты, а нонсы требуют сервера, которого у нас нет.
  # Убрать можно будет только вместе со статикой.
  #
  # 'wasm-unsafe-eval' - распаковщик геометрии. Модель сжата meshopt, и его
  # декодер это WebAssembly; без этого разрешения браузер глушит его, сцена
  # падает целиком и экран показывает вещь строкой. Проверено на проде: пока
  # разрешения не было, вместо футболки висело «This view needs WebGL».
  #
  # Это не то же самое, что 'unsafe-eval': запускать eval() по-прежнему
  # нельзя, разрешается ровно компиляция wasm.
  #
  # auth.privy.io - iframe встроенного кошелька, без него не подписать.
  # challenges.cloudflare.com - капча Privy при входе.
  # *.rpc.privy.systems - их узлы RPC.
  #
  # explorer-api.walletconnect.com - реестр кошельков. Без него Privy не
  # строит список и показывает одну почту: ни Phantom, ни Solflare, ни
  # Backpack в окне не появляются. Оттуда же приходят их значки, поэтому
  # адрес стоит и в img-src. Проверено на проде: пока адрес был закрыт, окно
  # входа состояло из одного поля для почты.
  #
  # relay.walletconnect - сам канал связи с мобильным кошельком.
  #
  # blob: в connect-src - для модели вещи. GLTFLoader достаёт запечённые в
  # .glb текстуры и грузит их по blob:-адресу через fetch, а не как картинку,
  # поэтому одного blob: в img-src мало. Без него в консоли прода две ошибки
  # «Couldn't load texture» на каждом открытии сцены. Локально не всплывает:
  # dev-сервер заголовки из этого файла не применяет.
  #
  # Supabase в img-src - креативы ставок. Они лежат в его хранилище, и без
  # адреса на вещи оказалась бы пустая рамка вместо логотипа лидера.
  #
  # helius-rpc.com в connect-src - наша нода, и https, и wss. Без неё браузер
  # режет каждый запрос к цепочке как «Failed to fetch», хотя сама нода отвечает:
  # запрос не доходит, CSP глушит его раньше. Публичные ноды Solana оставлены
  # запасным адресом. Звёздочка покрывает devnet/mainnet/beta - поддомен у них
  # разный, ключ один.
  #
  # worker-src 'self' - пуш-воркер. Без своей директивы браузер проверяет
  # воркеры по child-src, а там одни окна Privy без 'self', и регистрация
  # /push-worker.js падала с нарушением CSP: колокольчик молчал на нажатие.
  # Проверено на проде.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://explorer-api.walletconnect.com https://islmypspqjxuhplcibam.supabase.co; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; worker-src 'self'; child-src https://auth.privy.io https://verify.walletconnect.com https://verify.walletconnect.org; frame-src https://auth.privy.io https://verify.walletconnect.com https://verify.walletconnect.org https://challenges.cloudflare.com; connect-src 'self' blob: https://auth.privy.io https://*.rpc.privy.systems https://islmypspqjxuhplcibam.supabase.co wss://islmypspqjxuhplcibam.supabase.co https://explorer-api.walletconnect.com https://api.web3modal.org wss://relay.walletconnect.com wss://relay.walletconnect.org https://*.helius-rpc.com wss://*.helius-rpc.com https://api.devnet.solana.com https://api.mainnet-beta.solana.com

  # Никто не смеет положить нас в свой iframe. Защита от кликджекинга: иначе
  # наш экран накрывают приманкой, человек жмёт «забрать приз», а жмёт «Bid».
  # frame-ancestors выше делает то же самое для новых браузеров, этот - для старых.
  X-Frame-Options: DENY

  # Браузер не гадает тип файла по содержимому: загруженная картинка не сможет
  # притвориться скриптом.
  X-Content-Type-Options: nosniff

  # Чужим сайтам не сообщаем, с какой именно страницы к ним пришли.
  Referrer-Policy: strict-origin-when-cross-origin

  # Ничего из этого нам не нужно, и пусть будет выключено.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# В имени файла хэш сборки, поэтому по этому адресу содержимое не меняется.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
