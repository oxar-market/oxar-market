# Supabase (project: oxar, ref islmypspqjxuhplcibam, eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://islmypspqjxuhplcibam.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Privy: вход и кошелёк, вместо прежней связки wallet-adapter плюс письмо.
#
# App id публичный - он уезжает в браузер вместе с бандлом, прятать нечего.
# Секрет серверный: клиентскому SDK он не нужен, и проверка токена в Supabase
# идёт по открытому JWKS Privy, тоже без него. Нужен только серверному API.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Куда уходит комиссия платформы. Адрес Solana, свой на каждую сеть.
# Пусто - комиссия не берётся.
NEXT_PUBLIC_OXAR_FEE_WALLET=

# Google Slides: сборка питч-дека скриптом. Client ID и secret - OAuth client
# типа Desktop app. Refresh token дописывает scripts/slides-auth.mjs.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
